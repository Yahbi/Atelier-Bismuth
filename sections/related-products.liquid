<section class="section {{ section.settings.bg }}">
  <div class="page-width">
    <div class="center" style="margin-bottom:clamp(1.5rem,3vw,3rem);" data-reveal>
      <span class="eyebrow">{{ section.settings.eyebrow }}</span>
      <h2 class="h3 mt-2">{{ section.settings.heading }}</h2>
    </div>
    <div class="grid cols-3">
      {%- assign shown = 0 -%}
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        {%- for product in recommendations.products limit: 3 -%}
          {%- render 'product-card', product: product, reveal_delay: forloop.index -%}
        {%- endfor -%}
      {%- else -%}
        {%- assign coll = product.collections.first -%}
        {%- for p in coll.products limit: 4 -%}
          {%- if p.id != product.id and shown < 3 -%}
            {%- render 'product-card', product: p, reveal_delay: forloop.index -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Related products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Continue browsing" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "select", "id": "bg", "label": "Background", "options": [ {"value":"","label":"Bone"}, {"value":"bg-surface","label":"White"}, {"value":"bg-alt","label":"Oat"} ], "default": "" }
  ]
}
{% endschema %}
