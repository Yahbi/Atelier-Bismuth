{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.limit | default: 4
-%}
<section class="section {{ section.settings.bg }}">
  <div class="page-width">
    <div class="flex items-center justify-between wrap gap-2" style="margin-bottom:clamp(1.5rem,3vw,3rem);" data-reveal>
      <div>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="h2 mt-2">{{ section.settings.heading | default: coll.title }}</h2>
      </div>
      {%- if coll.url -%}
        <a href="{{ coll.url }}" class="link-underline link-arrow">{{ section.settings.cta | default: 'View all' }} {% render 'icon', name: 'arrow-sm' %}</a>
      {%- endif -%}
    </div>

    <div class="grid cols-4">
      {%- if coll.products.size > 0 -%}
        {%- for product in coll.products limit: limit -%}
          {%- render 'product-card', product: product, reveal_delay: forloop.index -%}
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} Onboarding placeholders when no collection is connected yet {%- endcomment -%}
        {%- for i in (1..4) -%}
          <article class="product-card" data-reveal data-reveal-delay="{{ i }}">
            <div class="product-card__media media"><div class="placeholder-iri" style="position:absolute;inset:0;"></div></div>
            <h3 class="product-card__title">Edition No. {{ i }}</h3>
            <span class="product-card__dims">W120 × D60 × H45 cm</span>
            <div class="product-card__meta"><span class="product-card__type">Furniture</span><span class="product-card__price">$1,200</span></div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "New & Notable" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recent editions" },
    { "type": "text", "id": "cta", "label": "Link text", "default": "View all" },
    { "type": "range", "id": "limit", "min": 2, "max": 8, "step": 1, "label": "Products", "default": 4 },
    { "type": "select", "id": "bg", "label": "Background", "options": [ {"value":"","label":"Bone"}, {"value":"bg-surface","label":"White"}, {"value":"bg-alt","label":"Oat"} ], "default": "bg-surface" }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
