{%- assign img = section.settings.image -%}
<section class="section--flush">
  <div class="collection-hero" style="min-height:{{ section.settings.height }}vh;">
    <div class="collection-hero__media">
      {%- if img -%}
        <img src="{{ img | image_url: width: 2400 }}" srcset="{{ img | image_url: width: 1400 }} 1400w, {{ img | image_url: width: 2400 }} 2400w" sizes="100vw" width="2400" height="1350" loading="lazy" alt="{{ section.settings.heading | escape }}">
      {%- else -%}
        <div class="placeholder-iri" style="position:absolute;inset:0;"></div>
      {%- endif -%}
    </div>
    <div class="page-width" style="position:relative;z-index:1;text-align:{{ section.settings.align }};width:100%;">
      <div class="{% if section.settings.align == 'center' %}measure-wide{% else %}measure{% endif %}" {% if section.settings.align == 'center' %}style="margin-inline:auto;"{% endif %} data-reveal>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow" style="color:rgba(244,241,234,0.85);">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="h2 mt-2" style="color:#f4f1ea;">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<p class="lead mt-2" style="color:rgba(244,241,234,0.88);">{{ section.settings.text }}</p>{%- endif -%}
        {%- if section.settings.cta_text != blank -%}<a href="{{ section.settings.cta_link }}" class="btn btn--light mt-4">{{ section.settings.cta_text }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Lookbook banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "range", "id": "height", "min": 40, "max": 95, "step": 5, "unit": "vh", "label": "Height", "default": 75 },
    { "type": "select", "id": "align", "label": "Alignment", "options": [ {"value":"left","label":"Left"}, {"value":"center","label":"Center"} ], "default": "left" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Lookbook · 2026" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Bismuth interior" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A study in weight, light, and patina — our pieces photographed in lived-in rooms." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Explore the lookbook" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Lookbook banner" }]
}
{% endschema %}
