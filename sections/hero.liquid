{%- liquid
  assign img = section.settings.image
  assign fallback = section.settings.image_fallback_url | default: 'https://i.etsystatic.com/8535050/r/il/14fc6a/8160767980/il_fullxfull.8160767980_43hy.jpg'
  assign heading_alt = section.settings.heading_line_1 | append: ' ' | append: section.settings.heading_line_2 | strip
-%}
<section class="flag-hero" data-section-id="{{ section.id }}">
  <div class="flag-hero__bg">
    {%- if img != blank -%}
      <img class="flag-kb"
           src="{{ img | image_url: width: 2400 }}"
           srcset="{{ img | image_url: width: 900 }} 900w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2400 }} 2400w, {{ img | image_url: width: 3200 }} 3200w"
           sizes="100vw"
           width="2400" height="1500"
           fetchpriority="high"
           alt="{{ img.alt | escape | default: heading_alt | escape }}">
    {%- else -%}
      <img class="flag-kb"
           src="{{ fallback }}"
           width="2400" height="1500"
           fetchpriority="high"
           alt="{{ heading_alt | escape }}">
    {%- endif -%}
  </div>

  <div class="flag-hero__inner">
    {%- if section.settings.eyebrow != blank -%}
      <div class="flag-eyebrow flag-eyebrow--light flag-reveal">{{ section.settings.eyebrow }}</div>
    {%- endif -%}
    <h1 class="flag-hero__title flag-reveal flag-reveal--slow">
      {{ section.settings.heading_line_1 }}{%- if section.settings.heading_line_2 != blank -%}<br><em>{{ section.settings.heading_line_2 }}</em>{%- endif -%}
    </h1>
    {%- if section.settings.subheading != blank -%}
      <p class="flag-hero__sub flag-reveal flag-reveal--slow">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <div class="flag-hero__cue" aria-hidden="true">Scroll</div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero — monument",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "url", "id": "image_fallback_url", "label": "Fallback image URL", "info": "Used when no image is picked. Defaults to the Atelier Bismuth fountain photograph." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Atelier Bismuth — Los Angeles" },
    { "type": "text", "id": "heading_line_1", "label": "Heading — first line", "default": "Carved from" },
    { "type": "text", "id": "heading_line_2", "label": "Heading — second line (italic)", "default": "a single stone" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Furniture and objects cut from solid stone, finished by hand." },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true }
  ],
  "presets": [{ "name": "Hero — monument" }]
}
{% endschema %}
