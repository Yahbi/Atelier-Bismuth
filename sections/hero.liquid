{%- liquid
  assign img = section.settings.image
  assign img_m = section.settings.image_mobile | default: section.settings.image
-%}
<section class="hero {% if section.settings.layout == 'center' %}hero--center{% endif %}">
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      <video autoplay muted loop playsinline {% if img %}poster="{{ img | image_url: width: 1600 }}"{% endif %}>
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>
    {%- elsif img -%}
      <img src="{{ img | image_url: width: 2400 }}"
           srcset="{{ img_m | image_url: width: 900 }} 900w, {{ img | image_url: width: 1600 }} 1600w, {{ img | image_url: width: 2400 }} 2400w"
           sizes="100vw" width="2400" height="1350" fetchpriority="high" alt="{{ img.alt | escape | default: section.settings.heading | escape }}">
    {%- else -%}
      <div class="placeholder-iri" style="position:absolute;inset:0;"></div>
    {%- endif -%}
  </div>

  <div class="hero__inner page-width">
    <div class="{% if section.settings.layout == 'center' %}{% else %}measure-wide{% endif %}">
      {%- if section.settings.eyebrow != blank -%}
        <span class="eyebrow" style="color:rgba(244,241,234,0.85);" data-reveal>{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h1 class="hero__title display" data-reveal data-reveal-delay="1">{{ section.settings.heading | default: 'Atelier Bismuth' }}</h1>
      {%- if section.settings.subheading != blank -%}
        <p class="hero__sub lead" data-reveal data-reveal-delay="2">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="hero__actions" data-reveal data-reveal-delay="3">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_link }}" class="btn btn--light">{{ section.settings.cta_text }}</a>
        {%- endif -%}
        {%- if section.settings.cta2_text != blank -%}
          <a href="{{ section.settings.cta2_link }}" class="btn btn--ghost-light">{{ section.settings.cta2_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.settings.show_scroll_cue -%}
    <div class="scroll-cue">Scroll<span></span></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
    { "type": "url", "id": "video", "label": "Background video URL (mp4, optional)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Furniture & Home Decor" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Objects with a quiet gravity" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Sculptural, limited-edition furniture and décor — cast, carved, and finished by hand at Atelier Bismuth." },
    { "type": "text", "id": "cta_text", "label": "Primary button", "default": "Shop the collection" },
    { "type": "url", "id": "cta_link", "label": "Primary link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary button", "default": "Our story" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "select", "id": "layout", "label": "Layout", "options": [ {"value":"left","label":"Left"}, {"value":"center","label":"Center"} ], "default": "left" },
    { "type": "checkbox", "id": "show_scroll_cue", "label": "Show scroll cue", "default": true }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
