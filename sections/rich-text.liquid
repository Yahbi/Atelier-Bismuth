<section class="section {{ section.settings.bg }}">
  <div class="content-width {% if section.settings.align == 'center' %}center{% endif %}">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'eyebrow' -%}
          <span class="eyebrow" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {%- when 'heading' -%}
          <h2 class="{{ block.settings.size }} mt-2" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</h2>
        {%- when 'text' -%}
          <div class="lead mt-3 {% unless section.settings.align == 'center' %}measure-wide{% endunless %}" data-reveal {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <div class="mt-4" data-reveal {{ block.shopify_attributes }}><a href="{{ block.settings.link }}" class="btn btn--outline">{{ block.settings.label }}</a></div>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "align", "label": "Alignment", "options": [ {"value":"left","label":"Left"}, {"value":"center","label":"Center"} ], "default": "center" },
    { "type": "select", "id": "bg", "label": "Background", "options": [ {"value":"","label":"Bone"}, {"value":"bg-surface","label":"White"}, {"value":"bg-alt","label":"Oat"}, {"value":"bg-ink","label":"Ink"} ], "default": "" }
  ],
  "blocks": [
    { "type": "eyebrow", "name": "Eyebrow", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "Atelier Bismuth" } ] },
    { "type": "heading", "name": "Heading", "settings": [ { "type": "text", "id": "text", "label": "Text", "default": "A heading" }, { "type": "select", "id": "size", "label": "Size", "options": [ {"value":"h3","label":"Small"}, {"value":"h2","label":"Medium"}, {"value":"h1","label":"Large"} ], "default": "h2" } ] },
    { "type": "text", "name": "Text", "settings": [ { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story here.</p>" } ] },
    { "type": "button", "name": "Button", "settings": [ { "type": "text", "id": "label", "label": "Label", "default": "Learn more" }, { "type": "url", "id": "link", "label": "Link" } ] }
  ],
  "presets": [ { "name": "Rich text", "blocks": [ { "type": "eyebrow" }, { "type": "heading" }, { "type": "text" } ] } ]
}
{% endschema %}
