{%- liquid
  assign product = product
  assign current = product.selected_or_first_available_variant
  assign pid = 'productData_' | append: section.id
-%}

<section class="section bg-surface">
  <div class="page-width">
    <nav class="eyebrow" aria-label="Breadcrumb" style="display:block;margin-bottom:1.6rem;">
      <a href="{{ routes.root_url }}">Home</a> <span style="opacity:0.5;">/</span>
      {%- if product.collections.first -%}<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a> <span style="opacity:0.5;">/</span>{%- endif -%}
      <span style="color:var(--color-ink);">{{ product.title }}</span>
    </nav>

    <div class="pdp" data-gallery>
      {%- comment -%} ----------------------------- Gallery ----------------------------- {%- endcomment -%}
      <div class="pdp__gallery-wrap">
        <div class="pdp__gallery" data-gallery-main-wrap>
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              <div class="media{% if forloop.first %} pdp__main-media{% endif %}" {% if forloop.first %}data-gallery-main{% endif %}>
                <img src="{{ media | image_url: width: 1200 }}"
                     srcset="{{ media | image_url: width: 700 }} 700w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                     sizes="(max-width:900px) 96vw, 55vw"
                     width="1200" height="1500" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     alt="{{ media.alt | escape | default: product.title | escape }}">
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="media" style="grid-column:1/-1;aspect-ratio:3/2;"><div class="placeholder-iri" style="position:absolute;inset:0;"></div></div>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} ----------------------------- Info ----------------------------- {%- endcomment -%}
      <div class="pdp__info">
        <div class="flex items-center gap-2 wrap" style="margin-bottom:0.6rem;">
          {%- if product.vendor != blank -%}<span class="eyebrow">{{ product.vendor }}</span>{%- endif -%}
          {%- if product.metafields.specs.edition.value contains 'one' -%}<span class="product-card__badge" style="position:static;background:var(--color-ink);color:var(--color-bg);">One of one</span>
          {%- elsif product.tags contains 'made-to-order' -%}<span class="product-card__badge" style="position:static;">Made to order</span>{%- endif -%}
        </div>

        <h1 class="h2">{{ product.title }}</h1>

        <div class="flex items-baseline gap-2 mt-2">
          <span class="pdp__price" data-product-price>{{ current.price | money }}</span>
          <span class="price--was" data-product-compare {% unless current.compare_at_price > current.price %}style="display:none;"{% endunless %}>{{ current.compare_at_price | money }}</span>
        </div>

        {%- render 'dimensions', product: product, mode: 'inline' -%}

        <hr class="hairline mt-3">

        {%- comment -%} Variant pickers {%- endcomment -%}
        <form data-product-form data-cart-form data-product-id="{{ pid }}" method="post" action="{{ routes.cart_add_url }}" class="stack mt-3" style="--stack-gap:1.3rem;">
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              <div class="variant-option">
                <span class="eyebrow eyebrow--ink" style="display:block;margin-bottom:0.6rem;">{{ option.name }}</span>
                <div class="variant-pills">
                  {%- for value in option.values -%}
                    <label class="variant-pill {% if option.selected_value == value %}is-active{% endif %}" data-variant-pill data-option-target="{{ option.position }}" data-value="{{ value | escape }}">
                      <input type="radio" name="option-{{ option.position }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                      {{ value }}
                    </label>
                  {%- endfor -%}
                </div>
                <select class="visually-hidden" data-option-index="{{ option.position }}" aria-hidden="true" tabindex="-1">
                  {%- for value in option.values -%}<option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>{%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <input type="hidden" name="id" value="{{ current.id }}">

          <div class="flex gap-2 wrap items-center">
            <div class="qty" data-qty>
              <button type="button" data-qty-minus aria-label="Decrease quantity">−</button>
              <input type="text" name="quantity" value="1" inputmode="numeric" aria-label="{{ 'products.product.quantity' | t }}">
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
            <button type="submit" class="btn btn--block" style="flex:1;min-width:200px;" {% unless current.available %}disabled{% endunless %}>
              <span data-btn-label>{% if current.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}</span>
            </button>
          </div>

          {%- if product.selling_plan_groups.size == 0 -%}
            {{ form | payment_button }}
          {%- endif -%}
        </form>

        {%- if product.description != blank -%}
          <div class="pdp__desc lead mt-4">{{ product.description }}</div>
        {%- endif -%}

        {%- comment -%} Trust row {%- endcomment -%}
        <ul class="trust-row mt-4">
          <li>{% render 'icon', name: 'truck', size: 18 %} White-glove delivery</li>
          <li>{% render 'icon', name: 'hand', size: 18 %} Hand finished</li>
          <li>{% render 'icon', name: 'ruler', size: 18 %} True-to-spec dimensions</li>
        </ul>

        {%- comment -%} Accordions: specs / materials / care / shipping {%- endcomment -%}
        <div class="accordion mt-4">
          <details class="accordion__item" open>
            <summary class="accordion__trigger">{{ 'products.product.dimensions' | t }}<span class="accordion__icon"></span></summary>
            <div class="accordion__panel">{%- render 'dimensions', product: product, mode: 'table' -%}</div>
          </details>

          {%- if product.metafields.specs.materials != blank or product.metafields.specs.finish != blank -%}
            <details class="accordion__item">
              <summary class="accordion__trigger">{{ 'products.product.materials' | t }}<span class="accordion__icon"></span></summary>
              <div class="accordion__panel">
                {%- if product.metafields.specs.materials != blank -%}<p>{{ product.metafields.specs.materials }}</p>{%- endif -%}
                {%- if product.metafields.specs.finish != blank -%}<p class="mt-2"><strong>Finish:</strong> {{ product.metafields.specs.finish }}</p>{%- endif -%}
                {%- if product.metafields.specs.sustainability != blank -%}<p class="mt-2">{{ product.metafields.specs.sustainability }}</p>{%- endif -%}
              </div>
            </details>
          {%- endif -%}

          <details class="accordion__item">
            <summary class="accordion__trigger">{{ 'products.product.care' | t }}<span class="accordion__icon"></span></summary>
            <div class="accordion__panel">{{ product.metafields.specs.care | default: section.settings.default_care }}</div>
          </details>

          <details class="accordion__item">
            <summary class="accordion__trigger">{{ 'products.product.shipping' | t }}<span class="accordion__icon"></span></summary>
            <div class="accordion__panel">{{ section.settings.shipping_text }}</div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>

{%- comment -%} Variant data for JS {%- endcomment -%}
<script>
  window["{{ pid }}"] = {
    variants: [
      {%- for v in product.variants -%}
      { id: {{ v.id }}, price: {{ v.price }}, compare_at_price: {{ v.compare_at_price | default: 0 | json }}, available: {{ v.available }}, options: {{ v.options | json }}, title: {{ v.title | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  };
</script>

{%- comment -%} JSON-LD structured data {%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | truncate: 300 | json }},
  {% if product.featured_media %}"image": ["https:{{ product.featured_media | image_url: width: 1200 }}"],{% endif %}
  "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
  "sku": {{ current.sku | default: product.id | json }},
  "offers": {
    "@type": "Offer",
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": "{{ current.price | divided_by: 100.0 }}",
    "availability": "{% if current.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}",
    "url": "{{ shop.url }}{{ product.url }}"
  }
}
</script>

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "textarea", "id": "default_care", "label": "Default care text", "default": "Dust with a soft, dry cloth. Avoid prolonged direct sunlight and standing moisture. For solid woods, treat occasionally with a natural wax to nourish the grain." },
    { "type": "textarea", "id": "shipping_text", "label": "Shipping text", "default": "Made-to-order pieces ship in 3–6 weeks. Furniture is delivered white-glove, insured, to your room of choice. Smaller décor ships within 3–5 business days, carefully packed by hand." }
  ]
}
{% endschema %}
