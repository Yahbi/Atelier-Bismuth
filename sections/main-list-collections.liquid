<div class="page-width section--tight center">
  <span class="eyebrow" data-reveal>{{ shop.name }}</span>
  <h1 class="h1 mt-2" data-reveal data-reveal-delay="1">{{ section.settings.heading | default: 'Collections' }}</h1>
</div>
<section class="section bg-surface" style="padding-top:0;">
  <div class="page-width">
    <div class="grid cols-3">
      {%- for coll in collections -%}
        {%- unless coll.handle == 'frontpage' -%}
          <a href="{{ coll.url }}" class="collection-tile" data-reveal data-reveal-delay="{{ forloop.index | modulo: 3 }}">
            <div class="media media--tall media-zoom">
              {%- assign feat = coll.image | default: coll.featured_image -%}
              {%- if feat -%}
                <img src="{{ feat | image_url: width: 900 }}" width="900" height="1200" loading="lazy" alt="{{ coll.title | escape }}">
              {%- else -%}
                <div class="placeholder-iri" style="position:absolute;inset:0;"></div>
              {%- endif -%}
            </div>
            <div class="collection-tile__caption">
              <h2 class="h3">{{ coll.title }}</h2>
              <span class="product-card__dims">{{ coll.products_count }} pieces</span>
            </div>
          </a>
        {%- endunless -%}
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}
{ "name": "Collections list", "settings": [ { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" } ] }
{% endschema %}
