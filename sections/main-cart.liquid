<section class="section bg-surface">
  <div class="content-width">
    <h1 class="h1" style="margin-bottom:2rem;">{{ 'cart.title' | t }}</h1>

    {%- if cart.item_count == 0 -%}
      <div class="stack" style="--stack-gap:1.4rem;">
        <p class="lead">{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn" style="align-self:start;">{{ 'cart.empty_cta' | t }}</a>
      </div>
    {%- else -%}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="cart-table">
          {%- for item in cart.items -%}
            <div class="cart-line" style="grid-template-columns:120px 1fr auto;">
              <a href="{{ item.url }}" class="cart-line__media media">
                {%- if item.image -%}<img src="{{ item.image | image_url: width: 240 }}" width="120" height="150" alt="{{ item.title | escape }}">{%- else -%}<div class="placeholder-iri" style="position:absolute;inset:0;"></div>{%- endif -%}
              </a>
              <div>
                <a href="{{ item.url }}"><h2 class="cart-line__title" style="font-size:1.3rem;">{{ item.product.title }}</h2></a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-line__dims">{{ item.variant.title }}</p>{%- endunless -%}
                <p class="cart-line__dims">{% render 'dimensions', product: item.product, mode: 'inline' %}</p>
                <div class="flex items-center gap-2 mt-2">
                  <div class="qty" data-qty>
                    <button type="button" data-qty-minus aria-label="Decrease">−</button>
                    <input type="text" name="updates[]" value="{{ item.quantity }}" data-line-change data-line="{{ forloop.index }}" inputmode="numeric"
                      onchange="fetch('{{ routes.cart_change_url }}',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({line:{{ forloop.index }},quantity:parseInt(this.value)})}).then(()=>location.reload());">
                    <button type="button" data-qty-plus aria-label="Increase">+</button>
                  </div>
                  <a href="{{ item.url_to_remove }}" class="link-underline" style="font-size:0.68rem;">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div class="h4" style="font-family:var(--font-body);font-size:1.05rem;">{{ item.final_line_price | money }}</div>
            </div>
          {%- endfor -%}
        </div>

        <div class="flex justify-between items-start wrap gap-2" style="margin-top:2.5rem;">
          <a href="{{ routes.all_products_collection_url }}" class="link-underline link-arrow">Continue browsing {% render 'icon', name: 'arrow-sm' %}</a>
          <div style="min-width:300px;">
            <div class="flex justify-between items-baseline" style="margin-bottom:0.4rem;">
              <span class="eyebrow eyebrow--ink">{{ 'cart.subtotal' | t }}</span>
              <span class="h3" style="font-family:var(--font-body);">{{ cart.total_price | money }}</span>
            </div>
            <p class="product-card__dims" style="margin-bottom:1.2rem;">{{ 'cart.taxes_note' | t }}</p>
            <button type="submit" name="checkout" class="btn btn--block">{{ 'cart.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {%- endif -%}
  </div>
</section>
{% schema %}
{ "name": "Cart" }
{% endschema %}
