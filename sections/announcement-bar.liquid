{%- if section.settings.text != blank -%}
  <div class="announcement">
    {{ section.settings.text }}
    {%- if section.settings.link_text != blank and section.settings.link != blank -%}
      &nbsp;<a href="{{ section.settings.link }}" class="link-underline" style="color:inherit;font-size:0.66rem;">{{ section.settings.link_text }}</a>
    {%- endif -%}
  </div>
{%- endif -%}
{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Complimentary white-glove delivery on furniture" },
    { "type": "text", "id": "link_text", "label": "Link text" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
