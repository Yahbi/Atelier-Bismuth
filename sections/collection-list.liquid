{%- liquid
  assign cols = section.blocks.size
  if cols > 3
    assign cols = 3
  endif
-%}
<section class="section {{ section.settings.bg }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="center" style="margin-bottom:clamp(2rem,4vw,4rem);" data-reveal>
        {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="h2 mt-2">{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="grid cols-{{ cols }}">
      {%- for block in section.blocks -%}
        {%- assign coll = collections[block.settings.collection] -%}
        {%- assign feat = block.settings.image | default: coll.image | default: coll.featured_image -%}
        <a href="{{ coll.url | default: block.settings.link | default: '#' }}" class="collection-tile" data-reveal data-reveal-delay="{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="media media--tall media-zoom">
            {%- if feat -%}
              <img src="{{ feat | image_url: width: 900 }}" srcset="{{ feat | image_url: width: 600 }} 600w, {{ feat | image_url: width: 1000 }} 1000w" sizes="(max-width:600px) 90vw, 32vw" width="900" height="1200" loading="lazy" alt="{{ block.settings.title | default: coll.title | escape }}">
            {%- else -%}
              <div class="placeholder-iri" style="position:absolute;inset:0;"></div>
            {%- endif -%}
          </div>
          <div class="collection-tile__caption">
            {%- if block.settings.count_label != blank -%}<span class="eyebrow">{{ block.settings.count_label }}</span>{%- endif -%}
            <h3 class="h3" style="margin-top:0.3rem;">{{ block.settings.title | default: coll.title }}</h3>
            <span class="link-underline" style="margin-top:0.5rem;">{{ block.settings.cta | default: 'Explore' }}</span>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Collections" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Two disciplines, one hand" },
    { "type": "select", "id": "bg", "label": "Background", "options": [ {"value":"","label":"Bone"}, {"value":"bg-surface","label":"White"}, {"value":"bg-alt","label":"Oat"} ], "default": "" }
  ],
  "max_blocks": 3,
  "blocks": [
    {
      "type": "tile",
      "name": "Collection tile",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Override image" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "count_label", "label": "Label", "default": "Collection" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Explore" },
        { "type": "url", "id": "link", "label": "Fallback link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection grid",
      "blocks": [
        { "type": "tile", "settings": { "title": "Furniture", "count_label": "Collection" } },
        { "type": "tile", "settings": { "title": "Home Decor", "count_label": "Collection" } }
      ]
    }
  ]
}
{% endschema %}
