{%- comment -%} Open Graph & Twitter meta {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | default: shop.name }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% else %}website{% endif %}">
{%- if page_description -%}<meta property="og:description" content="{{ page_description | escape }}">{%- endif -%}
{%- if request.page_type == 'product' and product.featured_media -%}
  <meta property="og:image" content="https:{{ product.featured_media | image_url: width: 1200 }}">
{%- elsif settings.logo -%}
  <meta property="og:image" content="https:{{ settings.logo | image_url: width: 1200 }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title | default: shop.name }}">
{%- if page_description -%}<meta name="twitter:description" content="{{ page_description | escape }}">{%- endif -%}
