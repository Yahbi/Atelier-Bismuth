{%- comment -%}
  Price display. Params: product (or variant), show_from (bool)
{%- endcomment -%}
{%- liquid
  assign target = product
  assign on_sale = false
  if target.compare_at_price > target.price
    assign on_sale = true
  endif
-%}
<span class="price{% if on_sale %} price--has-sale{% endif %}">
  {%- if on_sale -%}
    <span class="price--was">{{ target.compare_at_price | money }}</span>
    <span class="price--sale">{{ target.price | money }}</span>
  {%- else -%}
    {%- if show_from and target.price_varies -%}
      {%- assign price_from = target.price | money -%}
      {{ 'products.product.from_price' | t: price: price_from }}
    {%- else -%}
      {{ target.price | money }}
    {%- endif -%}
  {%- endif -%}
</span>
