{%- comment -%}
  Price display. Params: product (or variant), show_from (bool).
  One confident price. No compare-at / strikethrough — sale grammar is
  intentionally absent (design-direction-v2, P0.1).
{%- endcomment -%}
{%- assign target = product -%}
<span class="price">
  {%- if target.price != blank -%}
    {%- if show_from and target.price_varies -%}
      {%- assign price_from = target.price | money -%}
      {{ 'products.product.from_price' | t: price: price_from }}
    {%- else -%}
      {{ target.price | money }}
    {%- endif -%}
  {%- endif -%}
</span>
